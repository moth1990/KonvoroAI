# Copy to .env and fill in. Never commit .env.

# Claude, direct API (local development). In AWS the app uses Bedrock through an IAM role instead.
ANTHROPIC_API_KEY=

# Host ports for docker-compose. Change them if they clash with something else on your machine.
KONBORO_PG_PORT=5433
KONBORO_S3_PORT=9000
KONBORO_SQS_PORT=9324
KONBORO_SQS_UI_PORT=9325
KONBORO_WEB_PORT=5180
KONBORO_API_PORT=8000

# Database roles (docs/db-schema.md §2): migrations run as the owner, the app as konboro_app (subject to RLS).
KONBORO_MIGRATION_DSN=postgresql+psycopg://konboro:konboro@localhost:5433/konboro
KONBORO_DATABASE_URL=postgresql+psycopg://konboro_app:konboro_app@localhost:5433/konboro
KONBORO_APP_DB_PASSWORD=konboro_app

# Where the backend and its tests find the services (defaults match the ports above).
KONBORO_TEST_PG_DSN=postgresql://konboro:konboro@localhost:5433/konboro
KONBORO_S3_ENDPOINT=http://localhost:9000
KONBORO_SQS_ENDPOINT=http://localhost:9324

# API (konboro/settings.py). Dev login until Cognito (S29): the emails in KONBORO_DEV_USERS
# (email=tenant_id, comma separated) sign in with this one shared password. The default user is
# the demo owner from `make seed`.
KONBORO_DEV_PASSWORD=konboro-dev-1234
# KONBORO_DEV_USERS=demo@konboro.local=tnt_01JD0DEM000000000000000000
# At least 32 bytes. Local only; production verifies Cognito tokens instead (S29).
KONBORO_JWT_SECRET=local-dev-only-signing-key-not-a-secret

# The web app's API base URL.
VITE_API_URL=http://localhost:8000
