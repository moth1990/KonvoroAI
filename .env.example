# Copy to .env and fill in. Never commit .env.

# Claude, direct API (local development). In AWS the app uses Bedrock through an IAM role instead.
ANTHROPIC_API_KEY=

# Host ports for docker-compose. Change them if they clash with something else on your machine.
KONBORO_PG_PORT=5433
KONBORO_S3_PORT=9000
KONBORO_SQS_PORT=9324
KONBORO_SQS_UI_PORT=9325
KONBORO_WEB_PORT=5180

# Where the backend and its tests find the services (defaults match the ports above).
KONBORO_TEST_PG_DSN=postgresql://konboro:konboro@localhost:5433/konboro
KONBORO_S3_ENDPOINT=http://localhost:9000
KONBORO_SQS_ENDPOINT=http://localhost:9324
