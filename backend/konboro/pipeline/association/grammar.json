{
  "version": "g2",
  "about": "04 §5.1: how electrical drawings write a device's attributes. Data, not code: a pattern found from a user's correction is added here and checked on the golden set first (04 §11). Matched against stage 2's normalized span text (units in their usual case, × between numbers). `scope` token: each word on its own; text: anywhere in the span. `values`: a group's name is the key it fills; `set`: fixed values; `build`: one of the builders in grammar.py. `families`: only these families read it (04 §5.1 rule 2: one text, several meanings, the symbol's family picks).",
  "patterns": [
    {
      "id": "curve_current",
      "re": "^(?P<curve>[BCDKZ])(?P<current_a>\\d{1,3}(?:\\.\\d)?)A?$"
    },
    {
      "id": "poles_current",
      "re": "^(?P<poles>[1-4])×(?P<current_a>\\d{1,4}(?:\\.\\d)?)A$",
      "not_families": [
        "fuse",
        "socket_outlet"
      ]
    },
    {
      "id": "poles_current_residual",
      "re": "^(?P<poles>[1-4])×(?P<current_a>\\d{1,4})A?/(?P<residual_a>0[.,]\\d{1,3})A?$"
    },
    {
      "id": "poles_by",
      "re": "^(?P<poles>[1-4])×(?P<current_a>\\d{1,4})$",
