        "level": {
          "title": "Level",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "value": {
          "examples": [
            "0.15"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$",
