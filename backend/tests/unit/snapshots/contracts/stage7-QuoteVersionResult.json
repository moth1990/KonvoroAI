        "manufacturer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manufacturer"
        },
        "margin_pct": {
          "anyOf": [
            {
              "examples": [
                "0.15"
              ],
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Margin Pct"
        },
        "margin_rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarginRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
