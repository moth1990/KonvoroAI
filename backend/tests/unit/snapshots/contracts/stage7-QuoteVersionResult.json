        "price_status": {
          "enum": [
            "ok",
            "stale",
            "discount_based",
            "missing"
          ],
          "title": "Price Status",
          "type": "string"
        },
        "qty": {
          "description": "numeric(12,3): products sold by the metre can be fractional",
          "examples": [
            "4",
            "2.5"
          ],
          "title": "Qty",
          "type": [
            "string",
            "number"
          ]
        },
        "rounding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rounding"
        },
        "sku": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sku"
