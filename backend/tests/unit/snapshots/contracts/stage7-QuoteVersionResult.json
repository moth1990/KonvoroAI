  "additionalProperties": false,
  "properties": {
    "currency": {
      "default": "ILS",
      "title": "Currency",
      "type": "string"
    },
    "customer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Customer Id"
    },
    "drawing_id": {
      "anyOf": [
        {
          "pattern": "^drw_[0-9A-Za-z_]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Drawing Id"
    },
    "panels": {
      "default": [],
      "items": {
        "$ref": "#/$defs/QuotePanel"
      },
      "title": "Panels",
      "type": "array"
    },
    "pricing_issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PricingIssue"
      },
      "title": "Pricing Issues",
      "type": "array"
    },
    "quote_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote Date"
    },
    "quote_id": {
      "pattern": "^quo_[0-9A-Za-z_]+$",
      "title": "Quote Id",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/Snapshot",
      "default": {
        "derived_rules_version": null,
        "fx_rates": [],
        "margin_rules_version": null,
        "price_list_ids": [],
        "vat_rate_id": null
      }
    },
    "status": {
      "enum": [
        "draft",
        "sent"
      ],
      "title": "Status",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "totals": {
      "$ref": "#/$defs/QuoteTotals"
    },
    "trace_id": {
      "pattern": "^trc_[0-9A-Za-z_]+$",
      "title": "Trace Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
