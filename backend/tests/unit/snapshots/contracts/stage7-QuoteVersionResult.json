        "cost_total": {
          "examples": [
            "0.15"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Cost Total",
          "type": "string"
        },
        "discount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Discount"
