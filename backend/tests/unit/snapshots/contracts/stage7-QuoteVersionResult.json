        "fx_rate": {
          "anyOf": [
            {
              "examples": [
                "0.15"
              ],
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Rate"
        },
        "original_currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Currency"
        },
        "price_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Date"
        },
        "price_list_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price List Id"
        },
        "supplier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supplier"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "CostSource",
      "type": "object"
    },
    "Derived": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "from_component_ids": {
          "default": [],
          "items": {
            "pattern": "^cmp_[0-9A-Za-z_]+$",
            "type": "string"
          },
          "title": "From Component Ids",
          "type": "array"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "explanation"
      ],
      "title": "Derived",
      "type": "object"
    },
    "Discount": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "examples": [
            "0.15"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Amount",
          "type": "string"
        },
        "pct": {
          "examples": [
            "0.15"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Pct",
          "type": "string"
        }
      },
      "required": [
        "pct",
        "amount"
      ],
      "title": "Discount",
      "type": "object"
    },
    "Line": {
