    "PanelTotals": {
      "additionalProperties": false,
      "properties": {
        "cost_total": {
          "examples": [
            "0.15"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Cost Total",
          "type": "string"
        },
        "line_counts": {
          "$ref": "#/$defs/LineCounts",
          "default": {
            "green": 0,
            "red": 0,
            "yellow": 0
          }
        },
        "price_total": {
          "examples": [
            "0.15"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Price Total",
          "type": "string"
