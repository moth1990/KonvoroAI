        "margin_pct": {
          "anyOf": [
            {
              "examples": [
                "0.15"
              ],
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Margin Pct"
        },
        "net_total": {
          "examples": [
            "0.15"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Net Total",
          "type": "string"
        },
        "price_total": {
          "examples": [
            "0.15"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Price Total",
          "type": "string"
        },
        "unpriced_count": {
          "default": 0,
          "title": "Unpriced Count",
          "type": "integer"
        },
        "vat": {
          "examples": [
            "0.15"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Vat",
          "type": "string"
        },
        "vat_rate": {
          "examples": [
            "0.15"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Vat Rate",
          "type": "string"
        }
      },
      "required": [
        "cost_total",
        "price_total",
        "net_total",
        "margin_abs",
        "margin_pct",
        "vat_rate",
        "vat",
        "gross_total"
      ],
      "title": "QuoteTotals",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "derived_rules_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived Rules Version"
        },
        "fx_rates": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Fx Rates",
          "type": "array"
        },
        "margin_rules_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Rules Version"
        },
        "price_list_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Price List Ids",
          "type": "array"
        },
        "vat_rate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vat Rate Id"
        }
      },
      "title": "Snapshot",
      "type": "object"
    },
    "StatusReason": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "anyOf": [
            {
              "pattern": "^iss_[0-9A-Za-z_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Id"
        },
        "source": {
          "enum": [
            "confidence",
            "match",
            "validator",
            "price",
            "missing",
            "user"
          ],
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "green",
            "yellow",
            "red"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "source",
        "status"
      ],
      "title": "StatusReason",
      "type": "object"
    }
