        "status_reasons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StatusReason"
          },
          "title": "Status Reasons",
          "type": "array"
        },
        "unit_cost": {
          "anyOf": [
            {
              "examples": [
                "0.15"
              ],
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Cost"
        },
        "unit_price": {
          "anyOf": [
            {
              "examples": [
                "0.15"
              ],
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Price"
        },
        "unit_price_raw": {
          "anyOf": [
            {
              "examples": [
                "0.15"
              ],
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Price Raw"
        }
      },
      "required": [
        "line_id",
        "line_type",
        "component_id",
        "sku",
        "description",
        "manufacturer",
        "qty",
        "unit_cost",
        "price_status",
        "unit_price_raw",
        "unit_price",
        "line_cost",
        "line_total",
        "margin_pct",
        "status"
