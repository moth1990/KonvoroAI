        "override": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override"
        },
        "parent_line_id": {
          "anyOf": [
            {
              "pattern": "^ln_[0-9A-Za-z_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Line Id"
