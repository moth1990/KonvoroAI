    "LineCounts": {
      "additionalProperties": false,
      "properties": {
        "green": {
          "default": 0,
          "title": "Green",
          "type": "integer"
        },
        "red": {
          "default": 0,
          "title": "Red",
          "type": "integer"
        },
        "yellow": {
          "default": 0,
          "title": "Yellow",
          "type": "integer"
        }
      },
      "title": "LineCounts",
      "type": "object"
    },
    "MarginRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "markup",
            "margin"
