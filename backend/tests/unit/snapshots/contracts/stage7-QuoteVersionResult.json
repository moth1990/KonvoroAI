        "line_id": {
          "pattern": "^ln_[0-9A-Za-z_]+$",
          "title": "Line Id",
          "type": "string"
        },
        "line_total": {
          "anyOf": [
            {
              "examples": [
                "0.15"
              ],
              "pattern": "^-?\\d+(\\.\\d+)?$",
