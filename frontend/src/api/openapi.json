              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Settings",
        "tags": [
          "settings"
        ]
      },
      "patch": {
        "operationId": "patch_settings_settings_patch",
        "requestBody": {
          "content": {
