            "description": "Approval-queue items waiting for a decision",
            "title": "Queue Pending",
            "type": "integer"
          }
        },
        "required": [
          "queue_pending",
          "missing_prices",
          "audit_omissions"
        ],
        "title": "HomeSummaryOut",
        "type": "object"
      },
      "LoginIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "flags": {
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "Every flag, evaluated on the server (13 §3.1)",
            "title": "Flags",
            "type": "object"
          },
          "plan": {
            "$ref": "#/components/schemas/PlanOut"
          },
          "quota": {
            "$ref": "#/components/schemas/QuotaOut"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantOut"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "tenant",
          "plan",
          "flags",
          "quota"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "MissingPricesItem": {
        "properties": {
          "count": {
            "title": "Count",
