        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "account"
        ]
      }
    },
    "/quota": {
      "get": {
        "description": "Also releases reservations older than 24 h (01 §4.5), so the numbers are current.",
        "operationId": "get_quota_quota_get",
