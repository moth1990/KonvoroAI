        "required": [
          "counter",
          "limit",
          "used",
          "reserved",
          "extra",
          "remaining",
          "state"
        ],
        "title": "QuotaCounterOut",
        "type": "object"
      },
      "QuotaOut": {
        "properties": {
          "counters": {
            "items": {
              "$ref": "#/components/schemas/QuotaCounterOut"
            },
            "title": "Counters",
            "type": "array"
          },
          "month": {
            "description": "First day of the quota month, in the tenant's timezone",
            "format": "date",
            "title": "Month",
            "type": "string"
          }
        },
        "required": [
          "month",
          "counters"
        ],
        "title": "QuotaOut",
        "type": "object"
      },
      "QuotaState": {
        "enum": [
          "ok",
          "quota_near",
          "quota_reached"
        ],
        "title": "QuotaState",
        "type": "string"
      },
      "QuoteList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/QuoteListItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "QuoteList",
        "type": "object"
      },
      "QuoteListItem": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "missing_prices": {
            "description": "Live lines of the current version that have no unit price",
            "title": "Missing Prices",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "description": "The quote's current version number",
            "title": "Version",
            "type": "integer"
          },
          "version_status": {
            "enum": [
              "draft",
              "sent"
            ],
            "title": "Version Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "version_status",
          "missing_prices",
          "updated_at"
        ],
        "title": "QuoteListItem",
        "type": "object"
      },
      "SettingsOut": {
        "properties": {
          "attribute_defaults": {
            "additionalProperties": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "object"
            },
            "title": "Attribute Defaults",
            "type": "object"
          },
          "brand_preferences": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Brand Preferences",
            "type": "object"
          },
          "enclosure_includes_default": {
            "additionalProperties": {
              "type": "boolean"
            },
            "propertyNames": {
              "enum": [
                "busbar",
                "n",
                "pe",
                "panels",
                "doors"
              ]
            },
            "title": "Enclosure Includes Default",
            "type": "object"
          },
          "labor": {
            "additionalProperties": true,
            "title": "Labor",
            "type": "object"
          },
          "min_line_margin": {
            "anyOf": [
              {
                "examples": [
                  "0.15"
                ],
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Line Margin"
          },
          "min_quote_margin": {
            "anyOf": [
              {
                "examples": [
                  "0.15"
                ],
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Quote Margin"
          },
          "rounding": {
            "title": "Rounding",
            "type": "string"
          },
          "stale_days": {
            "title": "Stale Days",
            "type": "integer"
          }
        },
        "required": [
          "brand_preferences",
          "attribute_defaults",
          "enclosure_includes_default",
          "min_line_margin",
          "min_quote_margin",
          "stale_days",
          "labor",
          "rounding"
        ],
        "title": "SettingsOut",
        "type": "object"
      },
      "SettingsPatch": {
        "additionalProperties": false,
        "description": "Only the fields sent are changed. A dict field is replaced as a whole. Flags are not here (S03 decision).\n\n`null` clears a margin floor; the other fields cannot be null.",
        "properties": {
          "attribute_defaults": {
            "anyOf": [
              {
                "additionalProperties": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "type": "object"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attribute Defaults"
          },
          "brand_preferences": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand Preferences"
          },
          "enclosure_includes_default": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "boolean"
                },
                "propertyNames": {
                  "enum": [
                    "busbar",
                    "n",
                    "pe",
                    "panels",
                    "doors"
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enclosure Includes Default"
          },
          "min_line_margin": {
            "anyOf": [
              {
                "examples": [
                  "0.15"
                ],
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Line Margin"
          },
          "min_quote_margin": {
            "anyOf": [
              {
                "examples": [
                  "0.15"
                ],
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Quote Margin"
          },
          "stale_days": {
            "anyOf": [
              {
                "maximum": 3650.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stale Days"
          }
        },
        "title": "SettingsPatch",
        "type": "object"
      },
      "TenantOut": {
