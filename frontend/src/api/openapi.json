          },
          "quote_name": {
            "title": "Quote Name",
            "type": "string"
          }
        },
        "required": [
          "quote_id",
          "quote_name",
          "count"
        ],
        "title": "MissingPricesItem",
        "type": "object"
      },
      "PasswordResetIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "PasswordResetIn",
        "type": "object"
      },
      "PlanOut": {
        "description": "The tenant's effective limits: plan values with the tenant's overrides applied (01 §4.3).",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "max_pages_per_file": {
            "title": "Max Pages Per File",
            "type": "integer"
          },
          "monthly_audit_limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "null = audits count against the quote limit",
            "title": "Monthly Audit Limit"
          },
          "monthly_quote_limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "null = unlimited",
            "title": "Monthly Quote Limit"
          },
          "name_he": {
            "title": "Name He",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name_he",
          "monthly_quote_limit",
          "monthly_audit_limit",
          "max_pages_per_file"
        ],
        "title": "PlanOut",
        "type": "object"
      },
      "QuotaCounterOut": {
        "properties": {
          "counter": {
            "enum": [
              "quote",
              "audit"
            ],
            "title": "Counter",
            "type": "string"
          },
          "extra": {
            "title": "Extra",
            "type": "integer"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "null = unlimited",
            "title": "Limit"
          },
          "remaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining"
          },
          "reserved": {
            "title": "Reserved",
            "type": "integer"
          },
          "state": {
            "$ref": "#/components/schemas/QuotaState"
          },
          "used": {
            "title": "Used",
            "type": "integer"
          }
