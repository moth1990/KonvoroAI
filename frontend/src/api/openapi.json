{
  "components": {
    "schemas": {
      "AuditOmissionsItem": {
        "properties": {
          "amount_at_risk": {
            "anyOf": [
              {
                "examples": [
                  "0.15"
                ],
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sum of the priced omissions; null when none is priced",
            "title": "Amount At Risk"
          },
          "audit_id": {
            "title": "Audit Id",
            "type": "string"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "quote_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The audited quote's number, from its header (11 §5)",
            "title": "Quote Number"
          }
        },
        "required": [
          "audit_id",
          "quote_number",
          "count",
          "amount_at_risk"
        ],
        "title": "AuditOmissionsItem",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthOut",
        "type": "object"
      },
      "HomeSummaryOut": {
        "description": "The home screen's \"waiting for you\" card (prototype `vHome`).",
        "properties": {
          "audit_omissions": {
            "items": {
              "$ref": "#/components/schemas/AuditOmissionsItem"
            },
            "title": "Audit Omissions",
